{
  "name": "@thebcms/medusa-plugin",
  "version": "0.1.0",
  "description": "BCMS (https://thebcms.com) integration for Medusa v2 - link CMS entries to products and serve them through Medusa's admin and storefront APIs.",
  "author": "BCMS",
  "license": "MIT",
  "homepage": "https://github.com/bcms/medusa-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcms/medusa-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/bcms/medusa-plugin/issues"
  },
  "files": [
    ".medusa/server",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "plugin",
    "medusa-plugin",
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-cms",
    "thebcms",
    "bcms",
    "cms",
    "headless-cms"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "publish:local": "medusa plugin:publish",
    "prepublishOnly": "medusa plugin:build",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathPattern=src/.*\\.spec\\.ts$",
    "test:integration:modules": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPattern=integration-tests/modules/.*\\.spec\\.ts$",
    "test:ci": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.12.4",
    "@medusajs/cli": "2.12.4",
    "@medusajs/framework": "2.12.4",
    "@medusajs/icons": "2.12.4",
    "@medusajs/js-sdk": "2.12.4",
    "@medusajs/medusa": "2.12.4",
    "@medusajs/test-utils": "2.12.4",
    "@medusajs/ui": "4.0.25",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.39",
    "@tanstack/react-query": "5.64.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.2.11",
    "yalc": "^1.0.0-pre.53",
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.12",
    "@medusajs/cli": "^2.12",
    "@medusajs/framework": "^2.12",
    "@medusajs/icons": "^2.12",
    "@medusajs/medusa": "^2.12",
    "@medusajs/test-utils": "^2.12",
    "@medusajs/ui": "^4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.5.2",
  "dependencies": {
    "@thebcms/client": "^2.0.1"
  }
}

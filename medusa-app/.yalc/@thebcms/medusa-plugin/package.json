{
  "name": "@thebcms/medusa-plugin",
  "version": "0.1.0",
  "description": "BCMS (https://thebcms.com) integration for Medusa v2 - link CMS entries to products and serve them through Medusa's admin and storefront APIs.",
  "author": "BCMS",
  "license": "MIT",
  "homepage": "https://github.com/bcms/medusa-plugin-bcms",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcms/medusa-plugin-bcms.git"
  },
  "bugs": {
    "url": "https://github.com/bcms/medusa-plugin-bcms/issues"
  },
  "files": [
    ".medusa/server",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "plugin",
    "medusa-plugin",
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-cms",
    "thebcms",
    "bcms",
    "cms",
    "headless-cms"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "publish:local": "medusa plugin:publish",
    "prepublishOnly": "medusa plugin:build",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathPattern=src/.*\\.spec\\.ts$",
    "test:integration:modules": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPattern=integration-tests/modules/.*\\.spec\\.ts$",
    "test:ci": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.19",
    "@medusajs/cli": "^2.19",
    "@medusajs/framework": "^2.19",
    "@medusajs/icons": "^2.19",
    "@medusajs/medusa": "^2.19",
    "@medusajs/test-utils": "^2.19",
    "@medusajs/ui": "^4.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.5.2",
  "dependencies": {
    "@thebcms/client": "^2.0.3"
  },
  "yalcSig": "ba6119ccc6fa1a00dc6b77ea573270b0"
}
